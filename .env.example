# Copy this file to .env and fill in real values.
# .env is gitignored and should never be committed.

# Groq API key (https://console.groq.com)
GROQ_API_KEY=

# Groq model used by the agent (evaluate + generate nodes).
# Check available models: groq client .models.list() or the console.
GROQ_MODEL=groq/compound-mini

# API key the Streamlit frontend sends as the X-API-Key header.
# The default below is used by the frontend if API_KEY is not set.
API_KEY=rag-secret-2026

# PostgreSQL / pgvector connection (local docker-compose defaults shown)
DB_NAME=crag_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Optional overrides for the embedding / reranker models
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2